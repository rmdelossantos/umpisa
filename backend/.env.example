# Optional for local (non-Docker) runs: copy to backend/.env.
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Leave unset to generate a secret into data/.jwt_secret on first run (at least 32 characters if set)
# JWT_SECRET=

# Create the demo accounts with `python -m scripts.seed_demo`
SEED_DEMO=true
DEMO_PASSWORD=umpisa-demo
COOKIE_SECURE=false
