# Optional: copy to .env (gitignored) to override defaults. Docker Compose reads it automatically.
# Nothing here is required: `docker compose up --build` works without a .env file.

# Leave unset to generate a secret on first start (kept in the data volume).
# To set your own (at least 32 characters): python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT_SECRET=

# Demo accounts from backend/scripts/seed_users.json, created on first start
SEED_DEMO=true
DEMO_PASSWORD=umpisa-demo

# Host port for the app (http://localhost:3000 by default)
APP_PORT=3000

# Set true when the app is served over HTTPS
COOKIE_SECURE=false
